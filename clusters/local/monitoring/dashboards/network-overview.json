          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  src AS `Source IP`,\n  dst AS `Destination IP`,\n  upper(protocol) AS `Protocol`,\n  sum(in_bytes) AS `Bytes`,\n  sum(in_packets) AS `Packets`,\n  count() AS `Flows`\nFROM flows.raw\nWHERE $__timeFilter(received_at)\n  AND source IN ($exporter)\nGROUP BY src, dst, protocol\nORDER BY `Bytes` DESC\nLIMIT 25",
