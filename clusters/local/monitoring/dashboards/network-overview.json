          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  multiIf(\n    dst_port = 443, 'HTTPS (443)',\n    dst_port = 80, 'HTTP (80)',\n    dst_port = 53, 'DNS (53)',\n    dst_port = 22, 'SSH (22)',\n    dst_port = 123, 'NTP (123)',\n    dst_port = 853, 'DNS-over-TLS (853)',\n    dst_port = 9000, 'ClickHouse (9000)',\n    dst_port = 2055, 'NetFlow (2055)',\n    dst_port = 9090, 'Prometheus (9090)',\n    dst_port = 3000, 'Grafana (3000)',\n    concat('Port ', toString(dst_port))\n  ) AS `Port`,\n  sum(in_bytes) AS `Bytes`\nFROM flows.raw\nWHERE $__timeFilter(received_at)\n  AND source IN ($exporter)\nGROUP BY `Port`\nORDER BY `Bytes` DESC\nLIMIT 10",
          "refId": "A"
        }
      ],
