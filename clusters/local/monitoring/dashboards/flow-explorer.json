      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "clickhouse-telemetry"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "sql",
          "rawSql": "SELECT\n  received_at AS `Timestamp`,\n  source AS `Exporter`,\n  src AS `Source IP`,\n  src_port AS `Src Port`,\n  dst AS `Destination IP`,\n  dst_port AS `Dst Port`,\n  protocol AS `Protocol`,\n  in_bytes AS `Bytes`,\n  in_packets AS `Packets`,\n  src_tos AS `ToS`,\n  version AS `Flow Ver`\nFROM flows.raw\nWHERE $__timeFilter(received_at)\n  AND source IN ($exporter)\nORDER BY received_at DESC\nLIMIT 500",
          "refId": "A"
        }
      ],
      "title": "Raw Flow Records",
      "type": "table"
