          "editorType": "sql",
          "format": 0,
          "queryType": "sql",
          "rawSql": "SELECT\n  toStartOfInterval(received_at, INTERVAL $__interval_s SECOND) AS time,\n  concat('Port ', toString(dst_port)) AS metric,\n  (sum(in_bytes) * 8) / $__interval_s AS bps\nFROM flows.raw\nWHERE $__timeFilter(received_at)\n  AND source IN ($exporter)\nGROUP BY time, metric\nORDER BY time",
          "refId": "A"
        }
      ],
      "title": "Throughput by Destination Port (bps)",
      "type": "timeseries"
