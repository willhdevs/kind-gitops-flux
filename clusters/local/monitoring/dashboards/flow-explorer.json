          "rawSql": "SELECT\n  protocol AS `Protocol`,\n  sum(in_bytes) AS `Bytes`\nFROM flows.raw\nWHERE $__timeFilter(received_at)\n  AND source IN ($exporter)\nGROUP BY `Protocol`\nORDER BY `Bytes` DESC",
